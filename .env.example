# ค่าจริงใส่ใน .env.local (ในเครื่อง) หรือ Vercel Project Settings — ห้าม commit

# --- LINE Messaging API (LINE Developers Console) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=     # long-lived token
NEXT_PUBLIC_LINE_OA_URL=       # https://line.me/R/ti/p/@xxxx (ต้องมีตอน build: Next ฝังค่านี้ลง bundle)

# --- Neon Postgres ---
DATABASE_URL=                  # pooled connection (host มี -pooler) — ใช้ตอนรันแอป
DIRECT_URL=                    # direct connection ไว้ให้ migrate (ถ้าไม่ตั้ง ใช้ DATABASE_URL_UNPOOLED ที่ Neon integration ใส่ให้ ไม่มีอีกก็ใช้ DATABASE_URL)

# --- Console login ---
ADMIN_PASSWORD=
SESSION_SECRET=                # random 32+ ตัวอักษร เช่น `openssl rand -base64 48`
